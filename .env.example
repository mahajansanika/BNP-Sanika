# Copy to `.env` and replace the placeholders. Never commit `.env`.

# --- Application ---
APP_NAME=Liquid+ API
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by docker compose) ---
POSTGRES_USER=liquidplus
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=liquidplus
POSTGRES_PORT=5432

# --- API ---
API_PORT=8000
# Used when running the API locally with uvicorn (outside Docker).
# Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+psycopg://liquidplus:replace-with-a-local-password@localhost:5432/liquidplus

# --- Auth (G2) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
