* text=auto

# Files executed inside Linux containers must keep LF line endings,
# even when checked out on Windows.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

*.ps1       text eol=crlf

*.png binary
*.jpg binary
*.pkl binary
*.joblib binary
